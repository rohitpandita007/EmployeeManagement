@model EmployeeManagement.Models.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="form-card narrow">
    <div class="form-top-icon" aria-hidden="true">↗</div>

    <p class="eyebrow">WELCOME BACK</p>
    <h1 class="page-title">Sign in to PeopleDesk</h1>
    <p class="page-subtitle mb-3">
        Enter your account details to continue to the employee portal.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert-error" role="alert">@ViewBag.Error</div>
    }

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors"></div>

        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="form-control"
                   placeholder="Enter your username"
                   autocomplete="username" />
            <span asp-validation-for="Username"
                  class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control"
                   type="password"
                   placeholder="Enter your password"
                   autocomplete="current-password" />
            <span asp-validation-for="Password"
                  class="field-validation-error"></span>
        </div>

        <button class="btn btn-primary" type="submit"
                style="width:100%;margin-top:5px">
            Sign in <span aria-hidden="true">→</span>
        </button>
    </form>

    <p class="login-footnote">
        Authorized users only · Keep your account credentials secure.
    </p>
</div>
