
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="nav-inner">
            <a class="brand" asp-controller="Employee" asp-action="Index">
                <span class="brand-mark">E</span>
                <span>
                    People<span class="brand-light">Desk</span>
                    <small>EMPLOYEE MANAGEMENT</small>
                </span>
            </a>

            <button class="menu-toggle" type="button"
                    aria-label="Toggle navigation"
                    aria-expanded="false"
                    onclick="document.querySelector('.nav-links').classList.toggle('open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') !== 'true')">
                ☰
            </button>

            <nav class="nav-links">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link"
                       asp-controller="Employee"
                       asp-action="Index">
                        Employees
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link"
                           asp-controller="User"
                           asp-action="Index">
                            Users
                        </a>
                    }

                    <span class="nav-user">
                        <span class="user-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </span>
                        <span>@(User.Identity.Name ?? "Account")</span>
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="nav-logout">
                        <button class="btn btn-outline btn-sm" type="submit">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm"
                       asp-controller="Account"
                       asp-action="Login">
                        Sign in
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="page-shell" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>© @DateTime.Now.Year PeopleDesk</span>
        <span>Employee Management System</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
