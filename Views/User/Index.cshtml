@model List<EmployeeManagement.Models.User>
@{
    ViewData["Title"] = "Users";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCESS & PERMISSIONS</p>
        <h1 class="page-title">Users</h1>
        <p class="page-subtitle">
            Manage accounts and roles that can access the application.
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Create">
        <span aria-hidden="true">＋</span> Add user
    </a>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2 class="panel-title">User accounts</h2>
            <p class="panel-note">
                @Model.Count account(s) configured
            </p>
        </div>
        <span class="badge badge-admin">Admin area</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">♙</div>
            <strong>No users found</strong>
            <span>Create a user account to get started.</span>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <span class="id-chip">#@user.Id</span>
                            </td>
                            <td class="cell-primary">@user.Username</td>
                            <td>
                                <span class="badge @(user.Role == "Admin"
                                    ? "badge-admin" : "badge-user")">
                                    ● @user.Role
                                </span>
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-outline btn-sm"
                                       asp-action="Edit"
                                       asp-route-id="@user.Id">
                                        Edit
                                    </a>
                                    <a class="btn btn-danger btn-sm"
                                       asp-action="Delete"
                                       asp-route-id="@user.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="mt-3">
    <a class="btn btn-outline"
       asp-controller="Employee"
       asp-action="Index">
        ← Back to employees
    </a>
</div>
