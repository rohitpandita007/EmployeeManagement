@model EmployeeManagement.Models.User
@{
    ViewData["Title"] = "Edit user";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCESS & PERMISSIONS</p>
        <h1 class="page-title">Edit user</h1>
        <p class="page-subtitle">
            Update account details and role permissions.
        </p>
    </div>
</div>

<div class="form-card narrow">
    <div class="form-top-icon" aria-hidden="true">✎</div>
    <h2 class="panel-title">Account information</h2>
    <p class="page-subtitle mb-3">User ID: #@Model.Id</p>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors"></div>

        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control"
                   autocomplete="username" />
            <span asp-validation-for="Username"
                  class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Role">Account role</label>
            <select asp-for="Role" class="form-control">
                <option value="User">User — standard access</option>
                <option value="Admin">Admin — management access</option>
            </select>
            <span asp-validation-for="Role"
                  class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="submit">
                Save changes
            </button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
