@model EmployeeManagement.Models.User
@{
    ViewData["Title"] = "Delete user";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCESS & PERMISSIONS</p>
        <h1 class="page-title">Delete user</h1>
        <p class="page-subtitle">
            Review the account before confirming deletion.
        </p>
    </div>
</div>

<div class="confirm-card">
    <div class="warning-icon" aria-hidden="true">!</div>

    <h1>Delete this account?</h1>
    <p>
        This user may lose access to the application.
        This action cannot be undone.
    </p>

    <div class="confirm-summary">
        <div><span>User ID</span><strong>#@Model.Id</strong></div>
        <div><span>Username</span><strong>@Model.Username</strong></div>
        <div><span>Role</span><strong>@Model.Role</strong></div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-actions">
            <button class="btn btn-danger" type="submit">
                Confirm delete
            </button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
