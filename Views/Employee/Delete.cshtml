@model EmployeeManagement.Models.Employee
@{
    ViewData["Title"] = "Delete employee";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">PEOPLE DIRECTORY</p>
        <h1 class="page-title">Delete employee</h1>
        <p class="page-subtitle">
            Review this record before confirming deletion.
        </p>
    </div>
</div>

<div class="confirm-card">
    <div class="warning-icon" aria-hidden="true">!</div>

    <h1>Delete this employee?</h1>
    <p>
        This action will remove the employee record.
        Please confirm that you want to continue.
    </p>

    <div class="confirm-summary">
        <div><span>Employee ID</span><strong>#@Model.Id</strong></div>
        <div><span>Name</span><strong>@Model.Name</strong></div>
        <div><span>Email</span><strong>@Model.Email</strong></div>
        <div><span>Department</span><strong>@Model.Department</strong></div>
        <div>
            <span>Salary</span>
            <strong>
                @Model.Salary.ToString(
                         "C",
                         System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
            </strong>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-actions">
            <button class="btn btn-danger" type="submit">
                Yes, delete employee
            </button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
