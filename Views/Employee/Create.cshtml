@model EmployeeManagement.Models.Employee
@{
    ViewData["Title"] = "Add employee";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">PEOPLE DIRECTORY</p>
        <h1 class="page-title">Add employee</h1>
        <p class="page-subtitle">
            Enter the details below to create a new employee record.
        </p>
    </div>
</div>

<div class="form-card">
    <div class="form-top-icon" aria-hidden="true">＋</div>
    <h2 class="panel-title">Employee information</h2>
    <p class="page-subtitle mb-3">
        Fields marked by validation are required.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors"></div>

        <div class="form-grid">
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control"
                       placeholder="e.g. Aditi Sharma" />
                <span asp-validation-for="Name"
                      class="field-validation-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control"
                       placeholder="name@company.com" />
                <span asp-validation-for="Email"
                      class="field-validation-error"></span>
            </div>

            <div class="field">
                <label asp-for="Department"></label>
                <input asp-for="Department" class="form-control"
                       placeholder="e.g. Engineering" />
                <span asp-validation-for="Department"
                      class="field-validation-error"></span>
            </div>

            <div class="field">
                <label asp-for="Salary"></label>
                <input asp-for="Salary" class="form-control"
                       type="number" step="0.01" min="0"
                       placeholder="e.g. 45000" />
                <span asp-validation-for="Salary"
                      class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="submit">
                Save employee
            </button>
            <a class="btn btn-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
